# ── 인증 (GitHub OAuth) ─────────────────────────────────────────
# github.com/settings/developers → New OAuth App
#   Homepage URL:               https://blog.subbi.dev
#   Authorization callback URL: https://blog.subbi.dev/api/auth/callback
# 로컬 개발용으로는 콜백이 http://localhost:3000/api/auth/callback 인
# 앱을 하나 더 만드는 게 편합니다.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 허용할 GitHub 계정의 "숫자 ID". 사용자명이 아닙니다.
#   curl -s https://api.github.com/users/subinsad | grep '"id"'
# 사용자명은 바꿀 수 있고, 놓아버린 이름은 남이 가져갈 수 있습니다.
GITHUB_OWNER_ID=

# 세션 쿠키 서명 키. 아무 긴 무작위 문자열이면 됩니다.
#   openssl rand -base64 32
AUTH_SECRET=

# ── 저장소 쓰기 ────────────────────────────────────────────────
# 프로덕션에서 글을 저장하면 이 토큰으로 저장소에 커밋합니다.
# Fine-grained PAT, 이 저장소에만, Contents: Read and write.
# 로그인 세션과 분리해 두었으므로 쿠키가 새어도 저장소는 안전합니다.
GITHUB_REPO_TOKEN=
GITHUB_REPO=subinsad/blog
GITHUB_BRANCH=main

# ── 사이트 ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://blog.subbi.dev
